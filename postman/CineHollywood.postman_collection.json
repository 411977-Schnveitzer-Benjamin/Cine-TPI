          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"idPelicula\": {{idPelicula}},\n  \"idSala\": {{idSala}},\n  \"idFormato\": 1,\n  \"fecha\": \"2020-01-01\",\n  \"horaInicio\": \"20:00:00\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/funcion"
          }
        },
        {
          "name": "Obtener función (precios por tipo de espectador)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const f = pm.response.json();",
            "const general = f.precios.find(p => p.idTipoEspectador === 1);",
            "const jubilado = f.precios.find(p => p.idTipoEspectador === 2);",
            "pm.test('Jubilado paga 15% menos (función sin promo)', () => pm.expect(jubilado.precio).to.eql(Math.round(general.precio * 0.85 * 100) / 100));"
          ] } } ],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/funcion/{{idFuncion}}" }
        },
        {
          "name": "Butacas de la función (guarda una libre)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const libre = pm.response.json().find(b => !b.ocupada && b.habilitada);",
            "pm.test('Hay una butaca libre', () => pm.expect(libre).to.exist);",
            "pm.collectionVariables.set('idButaca', libre.idButaca);"
          ] } } ],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/funcion/{{idFuncion}}/butacas" }
        }
