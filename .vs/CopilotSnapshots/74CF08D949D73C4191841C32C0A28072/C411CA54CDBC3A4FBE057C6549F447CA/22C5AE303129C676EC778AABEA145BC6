using CineHollywoodTPI.Data.Interfaces;
using CineHollywoodTPI.Data.Models;
using Microsoft.EntityFrameworkCore;

namespace CineHollywoodTPI.Data.Repositories
{
    public class VentaRepository : IVentaRepository
    {
        private readonly SistemaCineContext _context;

        public VentaRepository(SistemaCineContext context)
        {
            _context = context;
        }

        // 1. Consultar el Maestro de una venta con todo su detalle (Útil para mostrar el comprobante)
        public async Task<Venta?> GetByIdAsync(int id)
        {
            // Recuerda revisar si en tu contexto figura como .Ventas o .Venta
            return await _context.Venta
                .Include(v => v.IdClienteNavigation) // Trae los datos del cliente
                .Include(v => v.Entrada) // ¡Clave! Trae todas las entradas asociadas a esta venta (Detalle)
                .FirstOrDefaultAsync(v => v.IdVenta == id);
        }

        // 2. Traer todas las ventas (Ideal para que Matías arme el Dashboard de estadísticas)
        public async Task<IEnumerable<Venta>> GetAllAsync()
        {
            return await _context.Venta
                .Include(v => v.Entrada)
                .ToListAsync();
        }

        // 3. TRANSACCIÓN CRÍTICA: Registrar la venta y sus detalles juntos
        public async Task<bool> RegistrarVentaAsync(Venta venta, IEnumerable<Entrada> entradas)
        {
            // Iniciamos la transacción explícita en la base de datos
            using var transaction = await _context.Database.BeginTransactionAsync();
            try
            {
                // A. Insertar el registro Maestro (La Venta)
                _context.Venta.Add(venta);

                // Guardamos cambios temporalmente para que SQL Server genere el ID automático de la venta
                await _context.SaveChangesAsync();

                // B. Insertar los registros Detalle (Las Entradas)
                foreach (var entrada in entradas)
                {
                    // Le asignamos a cada entrada el ID de la venta que se acaba de generar arriba
                    entrada.IdVenta = venta.IdVenta;

                    _context.Entrada.Add(entrada);
                }

                // Guardamos los detalles en la base de datos
                await _context.SaveChangesAsync();

                // C. Si todo salió perfecto de punta a punta, confirmamos la operación
                await transaction.CommitAsync();
                return true;
            }
            catch (Exception)
            {
                // Si saltó CUALQUIER error (ej. se cortó la red, datos inválidos), deshacemos todo
                await transaction.RollbackAsync();
                return false;
            }
        }
    }
}
